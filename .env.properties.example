# ================================================================
# TEMPLATE — copie ce fichier en .env.dev.properties et remplis les valeurs
# Ce fichier EST commité dans Git (il sert de documentation)
# Les fichiers .env.dev.properties / .env.prod.properties, eux, ne le sont PAS
# ================================================================

# Base de données
# allowPublicKeyRetrieval=true est requis avec MySQL 8 (caching_sha2_password) sans SSL
DB_URL=jdbc:mysql://localhost:3306/raikiservices?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME

# JWT — clé secrète, minimum 32 caractères (256 bits) pour HS256
# Générer : openssl rand -base64 48
JWT_SECRET=CHANGE_ME_32_CHARS_MINIMUM
# Durées de vie en millisecondes
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Mail — Resend (https://resend.com)
RESEND_API_KEY=re_CHANGE_ME
MAIL_FROM=CHANGE_ME
# true = les emails sont ecrits dans les logs au lieu d'etre envoyes
MAIL_CONSOLE_MODE=false
# Destinataire des messages du formulaire de contact (defaut : MAIL_FROM)
CONTACT_RECIPIENT=

# URLs
APP_BASE_URL=http://localhost:8081
APP_FRONTEND_URL=http://localhost:3000
WEBSITE_URL=http://localhost:4200

# Cookie du refresh token
# COOKIE_SECURE : false en dev (HTTP), true en production (HTTPS)
# COOKIE_SAME_SITE : Strict si frontend et API partagent le domaine, sinon None (exige Secure=true)
COOKIE_SECURE=false
COOKIE_SAME_SITE=Strict

# Compte administrateur initial — créé au premier démarrage uniquement.
# À vider une fois le compte créé et le mot de passe changé.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ImageKit (https://imagekit.io) — images du site
# Console ImageKit > Developer options > API keys
# Laisser vide desactive l'envoi d'images sans empecher l'application de demarrer.
IMAGEKIT_PUBLIC_KEY=public_CHANGE_ME
IMAGEKIT_PRIVATE_KEY=private_CHANGE_ME
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/CHANGE_ME
# Dossier racine du compte ou sont rangees les images du site
IMAGEKIT_FOLDER=raiki

# Web Push (VAPID) — générer : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_SUBJECT=mailto:CHANGE_ME
